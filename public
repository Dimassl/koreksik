    function renderMatriksConfig() {
      const container = document.getElementById("cfg-grid-soal");
      container.innerHTML = "";
      const setengah = Math.ceil(dataSoalConfig.length / 2);
      const grupList = [dataSoalConfig.slice(0, setengah), dataSoalConfig.slice(setengah)].filter(g => g.length > 0);

      grupList.forEach(grup => {
        const card = document.createElement("div");
        card.className = "bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm";
        let html = `<div class="bg-slate-900 text-white px-4 py-2 text-xs font-bold grid grid-cols-12"><div class="col-span-2">No</div><div class="col-span-3">Tipe</div><div class="col-span-5">Kunci</div><div class="col-span-2 text-right">Poin</div></div><div class="divide-y divide-slate-100">`;
        grup.forEach(item => {
          const isMCMA = item.tipe === "MCMA";
          const btns = opsiConfig.map(h => {
            const aktif = item.kunci.includes(h);
            const cls = aktif ? (isMCMA ? "bg-emerald-600 text-white border-emerald-600" : "bg-teal-600 text-white border-teal-600") : "bg-white text-slate-600 border-slate-300";
            return `<button type="button" onclick="toggleKunciConfig(${item.no}, '${h}')" class="w-7 h-7 rounded-lg border text-xs font-bold ${cls}">${h}</button>`;
          }).join("");
          html += `
            <div class="px-4 py-1.5 grid grid-cols-12 items-center text-xs ${isMCMA ? 'bg-emerald-50/40' : ''}">
              <div class="col-span-2 font-bold">${item.no}.</div>
              <div class="col-span-3"><button type="button" onclick="toggleTipeConfig(${item.no})" class="px-2 py-0.5 rounded font-bold border ${isMCMA ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : 'bg-slate-100 text-slate-700 border-slate-300'}">${item.tipe}</button></div>
              <div class="col-span-5 flex gap-1">${btns}</div>
              <div class="col-span-2 text-right"><input type="number" step="0.5" value="${item.bobot}" onchange="dataSoalConfig[${item.no - 1}].bobot = parseFloat(this.value)||0; hitungRingkasanConfig();" class="w-12 px-1 py-0.5 text-right font-bold border border-slate-200 rounded"></div>
            </div>`;
        });
        card.innerHTML = html + `</div>`;
        container.appendChild(card);
      });
      hitungRingkasanConfig();
    }

    function toggleTipeConfig(no) {
      const s = dataSoalConfig[no - 1];
      s.tipe = s.tipe === "PG" ? "MCMA" : "PG";
      s.bobot = s.tipe === "MCMA" ? 4 : 2;
      if (s.tipe === "PG" && s.kunci.length > 1) s.kunci = [s.kunci[0]];
      renderMatriksConfig();
    }

    function toggleKunciConfig(no, h) {
      const s = dataSoalConfig[no - 1];
      if (s.tipe === "PG") s.kunci = [h];
      else s.kunci = s.kunci.includes(h) ? s.kunci.filter(x => x !== h) : [...s.kunci, h].sort();
      renderMatriksConfig();
    }

    function ubahJenjangConfig() {
      const j = document.getElementById("cfg-jenjang").value;
      opsiConfig = j === "SMA" ? ["A", "B", "C", "D", "E"] : ["A", "B", "C", "D"];
      if (j === "SMP") dataSoalConfig.forEach(s => s.kunci = s.kunci.filter(h => h !== "E"));
      renderMatriksConfig();
    }

    function autoKalibrasiConfig() {
      const jmlPG = dataSoalConfig.filter(s => s.tipe === "PG").length;
      const jmlMCMA = dataSoalConfig.filter(s => s.tipe === "MCMA").length;
      const totalUnit = jmlPG + jmlMCMA * 2;
      if (!totalUnit) return;
      const bPG = Math.round((100 / totalUnit) * 100) / 100;
      const bMCMA = Math.round((bPG * 2) * 100) / 100;
      dataSoalConfig.forEach(s => s.bobot = s.tipe === "PG" ? bPG : bMCMA);
      renderMatriksConfig();
    }

    function hitungRingkasanConfig() {
      document.getElementById("cfg-count-total").textContent = dataSoalConfig.length;
      document.getElementById("cfg-count-pg").textContent = dataSoalConfig.filter(s => s.tipe === "PG").length;
      document.getElementById("cfg-count-mcma").textContent = dataSoalConfig.filter(s => s.tipe === "MCMA").length;
      const tot = Math.round(dataSoalConfig.reduce((a, s) => a + s.bobot, 0) * 10) / 10;
      document.getElementById("cfg-badge-total").textContent = `Total: ${tot} Poin`;
    }

    async function jalankanAnbuso() {
      const idPaket = document.getElementById("anb-pilih-paket").value;
      const kktp = Number(document.getElementById("anb-kktp").value) || 75;
      const paket = getPaketAktifObj(idPaket);
      if (!paket) return;

      const res = await fetch(`/api/hasil/paket/${idPaket}`, { headers: { "Authorization": "Bearer " + authToken } });
      const rows = await res.json();
      if (rows.length < 2) {
        document.getElementById("anb-status").textContent = "Minimal dibutuhkan 2 siswa untuk menghitung Anbuso.";
        return;
      }

      const anb = hitungStatistikAnbuso(paket, rows, kktp);
      document.getElementById("anb-status").textContent = `Analisis selesai (${anb.statistikKelas.jumlahSiswa} siswa).`;
      document.getElementById("anb-hasil-container").classList.remove("hidden");

      const st = anb.statistikKelas;
      document.getElementById("anb-alpha").textContent = st.reliabilitasAlpha.toFixed(2);
      document.getElementById("anb-alpha-ket").textContent = st.kategoriAlpha;
      document.getElementById("anb-rata").textContent = st.rataRata;
      document.getElementById("anb-sebaran").textContent = `Min: ${st.nilaiTerendah} | Max: ${st.nilaiTertinggi} | SD: ${st.simpanganBaku}`;
      document.getElementById("anb-tuntas").textContent = st.persenTuntas + "%";
      document.getElementById("anb-tuntas-det").textContent = `${st.jumlahTuntas} dari ${st.jumlahSiswa} siswa tuntas`;

      document.getElementById("anb-jml-baik").textContent = anb.hasilButir.filter(b => b.keputusan === "Diterima").length + " Baik";
      document.getElementById("anb-jml-revisi").textContent = anb.hasilButir.filter(b => b.keputusan === "Revisi").length + " Revisi";
      document.getElementById("anb-jml-tolak").textContent = anb.hasilButir.filter(b => b.keputusan === "Ditolak").length + " Ganti";

      const opsiList = paket.jenjang === "SMA" ? ["A", "B", "C", "D", "E"] : ["A", "B", "C", "D"];
      document.getElementById("anb-tbody-soal").innerHTML = anb.hasilButir.map(b => {
        const pills = opsiList.map(h => {
          const pct = b.persenOpsi[h] || 0;
          const cls = b.kunci.includes(h) ? "bg-emerald-600 text-white font-bold" : (pct >= 30 ? "bg-rose-100 text-rose-800 font-bold" : "bg-slate-100 text-slate-600");
          return `<span class="px-1.5 py-0.5 rounded text-[11px] ${cls}">${h}:${pct}%</span>`;
        }).join(" ");
        const badgeKep = b.keputusan === "Diterima" ? "bg-emerald-100 text-emerald-800" : (b.keputusan === "Revisi" ? "bg-amber-100 text-amber-800" : "bg-rose-100 text-rose-800");
        return `
          <tr>
            <td class="py-2.5 px-4 font-bold">${b.no}.</td>
            <td class="py-2.5 px-3"><span class="font-bold">${b.tipe}</span> (${b.kunci.join(",")})</td>
            <td class="py-2.5 px-3 font-semibold">${b.pIndex.toFixed(2)} (${b.kategoriKesukaran})</td>
            <td class="py-2.5 px-3 font-semibold">${b.dIndex.toFixed(2)} (${b.kategoriDayaPembeda})</td>
            <td class="py-2.5 px-4 flex flex-wrap gap-1">${pills}</td>
            <td class="py-2.5 px-4"><span class="px-2 py-0.5 rounded-full font-bold ${badgeKep}">${b.keputusan}</span> <span class="text-slate-500 ml-1">${b.catatan}</span></td>
          </tr>`;
      }).join("");

      document.getElementById("anb-tbody-siswa").innerHTML = anb.profilSiswa.map(s => `
        <tr>
          <td class="py-2 px-4 font-bold">#${s.peringkat}</td>
          <td class="py-2 px-4 font-bold text-slate-900">${s.nama}</td>
          <td class="py-2 px-3">${s.kelas}</td>
          <td class="py-2 px-3 font-extrabold">${s.nilaiAkhir}</td>
          <td class="py-2 px-3"><span class="px-2 py-0.5 rounded-full font-bold ${s.statusKktp === 'Tuntas' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">${s.statusKktp}</span></td>
          <td class="py-2 px-4 text-slate-600">${s.jumlahSalah > 0 ? `(${s.jumlahSalah} soal): No. ${s.daftarNomorSalah}` : 'Sempurna'}</td>
        </tr>
      `).join("");
    }

    function hitungStatistikAnbuso(paket, rawRows, kktp) {
      const dataSiswa = rawRows.map(r => ({
        nama: r.nama_siswa,
        kelas: r.kelas,
        nilaiAkhir: Number(r.nilai_akhir) || 0,
        rawJawaban: JSON.parse(r.raw_jawaban_json || "{}"),
        skorPerSoal: JSON.parse(r.skor_per_soal_json || "[]")
      }));

      const N = dataSiswa.length;
      const daftarNilai = dataSiswa.map(s => s.nilaiAkhir);
      const rataRata = daftarNilai.reduce((a, b) => a + b, 0) / N;
      const variansTotal = daftarNilai.reduce((acc, v) => acc + Math.pow(v - rataRata, 2), 0) / N;
      const siswaUrut = [...dataSiswa].sort((a, b) => b.nilaiAkhir - a.nilaiAkhir);
      const nKelompok = Math.max(1, Math.round(N * 0.27));
      const kelompokAtas = siswaUrut.slice(0, nKelompok);
      const kelompokBawah = siswaUrut.slice(N - nKelompok);
      const opsiHuruf = paket.jenjang === "SMA" ? ["A", "B", "C", "D", "E"] : ["A", "B", "C", "D"];
      let jumlahVariansItem = 0;

      const hasilButir = paket.daftarSoal.map((soal, idx) => {
        const bobotMaks = Number(soal.bobot) || 1;
        const skorItem = dataSiswa.map(s => s.skorPerSoal[idx] || 0);
        const rataItem = skorItem.reduce((a, b) => a + b, 0) / N;
        jumlahVariansItem += skorItem.reduce((acc, v) => acc + Math.pow(v - rataItem, 2), 0) / N;

        const pIndex = rataItem / bobotMaks;
        const kategoriKesukaran = pIndex < 0.30 ? "Sukar" : (pIndex > 0.70 ? "Mudah" : "Sedang");
        const rataAtas = kelompokAtas.reduce((acc, s) => acc + (s.skorPerSoal[idx] || 0), 0) / nKelompok;
        const rataBawah = kelompokBawah.reduce((acc, s) => acc + (s.skorPerSoal[idx] || 0), 0) / nKelompok;
        const dIndex = (rataAtas / bobotMaks) - (rataBawah / bobotMaks);
        const kategoriDayaPembeda = dIndex >= 0.40 ? "Sangat Baik" : (dIndex >= 0.30 ? "Baik" : (dIndex >= 0.20 ? "Cukup" : "Jelek"));

        const distribusi = {};
        opsiHuruf.forEach(h => distribusi[h] = 0);
        dataSiswa.forEach(s => {
          const jaw = s.rawJawaban["no_" + soal.no];
          if (jaw && typeof jaw !== "object") {
            String(jaw).toUpperCase().split(",").map(x => x.trim()).filter(Boolean).forEach(h => {
              if (distribusi[h] !== undefined) distribusi[h]++;
            });
          }
        });
        const persenOpsi = {};
        opsiHuruf.forEach(h => persenOpsi[h] = Math.round((distribusi[h] / N) * 100));

        let keputusan = "Diterima", catatan = "Layak masuk bank soal.";
        if (dIndex < 0.20) { keputusan = "Ditolak"; catatan = "Daya pembeda rendah, wajib diganti."; }
        else if (dIndex < 0.30 || pIndex < 0.15 || pIndex > 0.90) { keputusan = "Revisi"; catatan = "Perbaiki pengecoh atau kesukaran soal."; }

        return {
          no: soal.no, tipe: soal.tipe, kunci: soal.kunci,
          pIndex: Math.round(pIndex * 100) / 100, kategoriKesukaran,
          dIndex: Math.round(dIndex * 100) / 100, kategoriDayaPembeda,
          persenOpsi, keputusan, catatan
        };
      });

      const k = paket.daftarSoal.length;
      let alpha = (variansTotal > 0 && k > 1) ? (k / (k - 1)) * (1 - (jumlahVariansItem / variansTotal)) : 0;
      alpha = Math.max(0, Math.round(alpha * 100) / 100);
      const kategoriAlpha = alpha >= 0.80 ? "Sangat Tinggi" : (alpha >= 0.70 ? "Tinggi (Reliabel)" : (alpha >= 0.50 ? "Cukup" : "Rendah"));

      const profilSiswa = siswaUrut.map((s, idx) => {
        const nomorSalah = [];
        paket.daftarSoal.forEach((soal, qIdx) => { if ((s.skorPerSoal[qIdx] || 0) < soal.bobot) nomorSalah.push(soal.no); });
        return {
          peringkat: idx + 1, nama: s.nama, kelas: s.kelas, nilaiAkhir: s.nilaiAkhir,
          statusKktp: s.nilaiAkhir >= kktp ? "Tuntas" : "Remedial",
          jumlahSalah: nomorSalah.length, daftarNomorSalah: nomorSalah.join(", ")
        };
      });

      return {
        statistikKelas: {
          jumlahSiswa: N,
          rataRata: Math.round(rataRata * 10) / 10,
          nilaiTertinggi: Math.max(...daftarNilai),
          nilaiTerendah: Math.min(...daftarNilai),
          simpanganBaku: Math.round(Math.sqrt(variansTotal) * 10) / 10,
          jumlahTuntas: dataSiswa.filter(s => s.nilaiAkhir >= kktp).length,
          persenTuntas: Math.round((dataSiswa.filter(s => s.nilaiAkhir >= kktp).length / N) * 100),
          reliabilitasAlpha: alpha,
          kategoriAlpha
        },
        hasilButir,
        profilSiswa
      };
    }
