  <script>
    let authMode = "login";
    let authToken = sessionStorage.getItem("asas_token") || "";
    let userProfile = JSON.parse(sessionStorage.getItem("asas_user") || "null");
    let userPin = sessionStorage.getItem("asas_pin") || "";

    let daftarPaketDecrypted = [];
    let antreanHasilGlobal = [];
    let opsiConfig = ["A", "B", "C", "D", "E"];
    let dataSoalConfig = Array.from({ length: 40 }, (_, i) => ({
      no: i + 1, tipe: i >= 30 ? "MCMA" : "PG", bobot: i >= 30 ? 4 : 2, kunci: []
    }));

    function getPaketAktifObj(idPaket) {
      return daftarPaketDecrypted.find(p => p.idPaket === idPaket) || null;
    }

    let mediaStream = null, scanLoopTimer = null, scannerState = "IDLE", prevGrayFrame = null, steadyTickCount = 0;
    const REQUIRED_STEADY_TICKS = 10;
    const analysisCanvas = document.createElement("canvas");
    analysisCanvas.width = 160; analysisCanvas.height = 120;
    const analysisCtx = analysisCanvas.getContext("2d", { willReadFrequently: true });

    window.onload = function() {
      renderMatriksConfig();
      if (authToken && userProfile && userPin) {
        masukKeAplikasi();
      }
    };

    async function deriveAesKey(pin, saltHex) {
      const enc = new TextEncoder();
      const saltBytes = new Uint8Array(saltHex.match(/.{1,2}/g).map(byte => parseInt(byte, 16)));
      const keyMaterial = await crypto.subtle.importKey("raw", enc.encode(pin), "PBKDF2", false, ["deriveKey"]);
      return crypto.subtle.deriveKey(
        { name: "PBKDF2", salt: saltBytes, iterations: 100000, hash: "SHA-256" },
        keyMaterial,
        { name: "AES-GCM", length: 256 },
        false,
        ["encrypt", "decrypt"]
      );
    }

    async function enkripsiDataSoal(objSoal, pin, saltHex) {
      const key = await deriveAesKey(pin, saltHex);
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const encoded = new TextEncoder().encode(JSON.stringify(objSoal));
      const cipherBuf = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, encoded);
      return {
        encryptedSoal: btoa(String.fromCharCode(...new Uint8Array(cipherBuf))),
        iv: btoa(String.fromCharCode(...iv))
      };
    }

    async function dekripsiDataSoal(encryptedBase64, ivBase64, pin, saltHex) {
      const key = await deriveAesKey(pin, saltHex);
      const iv = Uint8Array.from(atob(ivBase64), c => c.charCodeAt(0));
      const cipherBytes = Uint8Array.from(atob(encryptedBase64), c => c.charCodeAt(0));
      const plainBuf = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, key, cipherBytes);
      return JSON.parse(new TextDecoder().decode(plainBuf));
    }

    function switchAuthTab(mode) {
      authMode = mode;
      document.getElementById("auth-nama-box").classList.toggle("hidden", mode === "login");
      document.getElementById("tab-auth-login").className = mode === "login" ? "flex-1 py-2 rounded-lg bg-white text-slate-900 shadow-sm" : "flex-1 py-2 rounded-lg text-slate-500";
      document.getElementById("tab-auth-reg").className = mode === "register" ? "flex-1 py-2 rounded-lg bg-white text-slate-900 shadow-sm" : "flex-1 py-2 rounded-lg text-slate-500";
      document.getElementById("btn-auth-submit").textContent = mode === "login" ? "Masuk ke Ruang Kerja" : "Buat Akun Guru";
    }

    async function submitAuth() {
      const nama = document.getElementById("auth-nama").value;
      const email = document.getElementById("auth-email").value;
      const password = document.getElementById("auth-password").value;
      const pin = document.getElementById("auth-pin").value;

      if (!email || !password || !pin) return alert("Email, password, dan PIN Enkripsi wajib diisi.");

      const endpoint = authMode === "login" ? "/api/auth/login" : "/api/auth/register";
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nama, email, password })
      });
      const data = await res.json();
      if (!res.ok) return alert(data.error || "Gagal autentikasi.");

      authToken = data.token;
      userProfile = data.user;
      userPin = pin;

      sessionStorage.setItem("asas_token", authToken);
      sessionStorage.setItem("asas_user", JSON.stringify(userProfile));
      sessionStorage.setItem("asas_pin", userPin);

      masukKeAplikasi();
    }

    function masukKeAplikasi() {
      document.getElementById("auth-screen").classList.add("hidden");
      document.getElementById("main-app").classList.remove("hidden");
      document.getElementById("user-display-label").textContent = `${userProfile.nama} (${userProfile.email})`;
      document.getElementById("ocr-mode-select").value = localStorage.getItem("asas_ocr_mode") || "SIMULASI";
      document.getElementById("ocr-api-key-input").value = localStorage.getItem("asas_ocr_key") || "";
      muatDaftarPaket();
    }

    function logout() {
      sessionStorage.clear();
      location.reload();
    }

    function bukaModalOcr() { document.getElementById("modal-ocr").classList.remove("hidden"); }
    function tutupModalOcr() { document.getElementById("modal-ocr").classList.add("hidden"); }
    function simpanSettingOcr() {
      localStorage.setItem("asas_ocr_mode", document.getElementById("ocr-mode-select").value);
      localStorage.setItem("asas_ocr_key", document.getElementById("ocr-api-key-input").value.trim());
      alert("Pengaturan OCR tersimpan di browser Anda.");
      tutupModalOcr();
    }

    function bukaModul(nama) {
      if (nama !== "scan" && mediaStream) matikanKamera();
      ["scan", "config", "anbuso"].forEach(m => {
        document.getElementById("modul-" + m).classList.add("hidden");
        document.getElementById("nav-" + m).className = "px-3.5 py-2 rounded-lg text-xs font-bold text-slate-300 hover:text-white flex items-center gap-1.5 transition";
      });
      document.getElementById("modul-" + nama).classList.remove("hidden");
      document.getElementById("nav-" + nama).className = "px-3.5 py-2 rounded-lg text-xs font-bold bg-teal-600 text-white flex items-center gap-1.5 transition";
    }

    async function muatDaftarPaket(pilihId = null) {
      const res = await fetch("/api/paket", { headers: { "Authorization": "Bearer " + authToken } });
      if (res.status === 401) return logout();
      const rows = await res.json();

      daftarPaketDecrypted = [];
      for (const r of rows) {
        try {
          const daftarSoal = await dekripsiDataSoal(r.encrypted_soal, r.iv, userPin, userProfile.saltKunci);
          daftarPaketDecrypted.push({
            idPaket: r.id,
            mapel: r.mapel,
            namaPaket: r.nama_paket,
            jenjang: r.jenjang,
            aturanMcma: r.aturan_mcma,
            offsetTop: r.offset_top,
            daftarSoal: daftarSoal
          });
        } catch (e) {}
      }

      const optHtml = daftarPaketDecrypted.length > 0
        ? daftarPaketDecrypted.map(p => `<option value="${p.idPaket}">[${p.mapel}] ${p.namaPaket} (${p.daftarSoal.length} Soal - ${p.jenjang})</option>`).join("")
        : `<option value="">Belum ada paket soal (Buat di Tab 2)</option>`;

      document.getElementById("scan-pilih-paket").innerHTML = optHtml;
      document.getElementById("anb-pilih-paket").innerHTML = optHtml;

      const mapelUnik = [...new Set(daftarPaketDecrypted.map(p => p.mapel))];
      document.getElementById("ekspor-pilih-mapel").innerHTML = mapelUnik.length > 0
        ? mapelUnik.map(m => `<option value="${m}">${m}</option>`).join("")
        : `<option value="">Belum ada mapel</option>`;

      if (pilihId) {
        document.getElementById("scan-pilih-paket").value = pilihId;
        document.getElementById("anb-pilih-paket").value = pilihId;
      }
      muatAntreanHasil();
    }

    async function simpanPaketConfig() {
      const mapel = document.getElementById("cfg-mapel").value.trim();
      const namaPaket = document.getElementById("cfg-nama-paket").value.trim();
      if (!mapel || !namaPaket) return alert("Isi mata pelajaran dan nama paket.");
      const kosong = dataSoalConfig.filter(s => s.kunci.length === 0).map(s => s.no);
      if (kosong.length > 0) return alert("Kunci belum diisi pada nomor: " + kosong.join(", "));

      const { encryptedSoal, iv } = await enkripsiDataSoal(dataSoalConfig, userPin, userProfile.saltKunci);

      const res = await fetch("/api/paket", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Authorization": "Bearer " + authToken },
        body: JSON.stringify({
          mapel,
          namaPaket,
          jenjang: document.getElementById("cfg-jenjang").value,
          aturanMcma: document.getElementById("cfg-aturan-mcma").value,
          offsetTop: Number(document.getElementById("cfg-offset-top").value) || 52,
          encryptedSoal,
          iv
        })
      });
      const data = await res.json();
      if (res.ok) {
        alert(`Paket soal (${dataSoalConfig.length} soal) berhasil dienkripsi dan disimpan!`);
        await muatDaftarPaket(data.id);
        bukaModul("scan");
      }
    }

    async function toggleKamera() {
      if (mediaStream) matikanKamera();
      else await nyalakanKamera();
    }

    async function nyalakanKamera() {
      const idPaket = document.getElementById("scan-pilih-paket").value;
      if (!idPaket) return alert("Buat atau pilih paket soal terlebih dahulu.");

      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: "environment" }, width: { ideal: 1920 }, height: { ideal: 1080 } },
          audio: false
        });
        const videoEl = document.getElementById("live-video");
        videoEl.srcObject = mediaStream;
        videoEl.classList.remove("hidden");
        document.getElementById("cam-placeholder").classList.add("hidden");
        document.getElementById("viewfinder-overlay").classList.remove("hidden");

        const btn = document.getElementById("btn-toggle-cam");
        btn.innerHTML = `<span class="material-icons-round text-sm">videocam_off</span> Matikan`;
        btn.className = "px-3 py-1.5 rounded-lg bg-rose-600 text-white text-xs font-bold flex items-center gap-1";

        scannerState = "SCANNING";
        steadyTickCount = 0;
        prevGrayFrame = null;
        scanLoopTimer = setInterval(analisisFrameKamera, 120);
      } catch (err) {
        alert("Gagal mengakses kamera: " + err.message);
      }
    }

    function matikanKamera() {
      if (scanLoopTimer) clearInterval(scanLoopTimer);
      scanLoopTimer = null;
      if (mediaStream) { mediaStream.getTracks().forEach(t => t.stop()); mediaStream = null; }
      scannerState = "IDLE";
      document.getElementById("live-video").classList.add("hidden");
      document.getElementById("cam-placeholder").classList.remove("hidden");
      document.getElementById("viewfinder-overlay").classList.add("hidden");

      const btn = document.getElementById("btn-toggle-cam");
      btn.innerHTML = `<span class="material-icons-round text-sm">videocam</span> Nyalakan`;
      btn.className = "px-3 py-1.5 rounded-lg bg-slate-900 text-white text-xs font-bold flex items-center gap-1";
    }

    function analisisFrameKamera() {
      const videoEl = document.getElementById("live-video");
      if (!videoEl || videoEl.readyState < 2 || scannerState === "PROCESSING") return;

      const w = analysisCanvas.width, h = analysisCanvas.height;
      analysisCtx.drawImage(videoEl, 0, 0, w, h);
      const imgData = analysisCtx.getImageData(0, 0, w, h).data;

      const currentGray = new Float32Array(w * h);
      let edgeEnergySum = 0, edgeSamples = 0, motionDiffSum = 0, motionSamples = 0;

      for (let y = 15; y < h - 15; y++) {
        for (let x = 20; x < w - 20; x++) {
          const idx = (y * w + x) * 4;
          const gray = 0.299 * imgData[idx] + 0.587 * imgData[idx + 1] + 0.114 * imgData[idx + 2];
          const pIdx = y * w + x;
          currentGray[pIdx] = gray;
          if (x > 20 && y > 15) {
            edgeEnergySum += Math.abs(gray - currentGray[pIdx - 1]) + Math.abs(gray - currentGray[pIdx - w]);
            edgeSamples++;
          }
          if (prevGrayFrame) {
            motionDiffSum += Math.abs(gray - prevGrayFrame[pIdx]);
            motionSamples++;
          }
        }
      }

      prevGrayFrame = currentGray;
      const sharpness = edgeSamples > 0 ? edgeEnergySum / edgeSamples : 0;
      const motion = motionSamples > 0 ? motionDiffSum / motionSamples : 99;
      const sharpThreshold = Number(document.getElementById("sensitivitas-fokus").value) || 11;

      const badge = document.getElementById("focus-badge");
      const guideBox = document.getElementById("guide-box");
      const progressBar = document.getElementById("focus-progress");

      if (scannerState === "WAITING_SWAP") {
        if (motion > 14) {
          scannerState = "SCANNING";
          steadyTickCount = 0;
          badge.textContent = "Kertas baru terdeteksi, menstabilkan fokus...";
        }
        return;
      }

      if (sharpness >= sharpThreshold && motion < 5.5) {
        steadyTickCount++;
        const pct = Math.min(100, Math.round((steadyTickCount / REQUIRED_STEADY_TICKS) * 100));
        progressBar.style.width = pct + "%";
        guideBox.className = "w-full h-[78%] border-2 border-emerald-400 rounded-xl relative";
        badge.textContent = `Fokus terkunci (${pct}%) - Tahan sebentar...`;
        if (steadyTickCount >= REQUIRED_STEADY_TICKS) eksekusiTangkapInMemory();
      } else {
        steadyTickCount = Math.max(0, steadyTickCount - 2);
        progressBar.style.width = Math.round((steadyTickCount / REQUIRED_STEADY_TICKS) * 100) + "%";
        guideBox.className = "w-full h-[78%] border-2 border-dashed border-white/50 rounded-xl relative";
        badge.textContent = motion >= 5.5 ? "Tahan posisi HP agar tidak goyang..." : "Memfokuskan tabel jawaban...";
      }
    }

    function jepretManualDariStream() {
      if (!mediaStream) return alert("Nyalakan kamera terlebih dahulu.");
      if (scannerState !== "PROCESSING") eksekusiTangkapInMemory();
    }

    function bunyikanBeepSukses() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(880, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.15);
      } catch (e) {}
    }

    async function eksekusiTangkapInMemory() {
      const videoEl = document.getElementById("live-video");
      const idPaket = document.getElementById("scan-pilih-paket").value;
      const paket = getPaketAktifObj(idPaket);
      if (!videoEl || !paket) return;

      scannerState = "PROCESSING";
      bunyikanBeepSukses();
      if (navigator.vibrate) navigator.vibrate(80);

      const badge = document.getElementById("focus-badge");
      badge.textContent = "Membaca lembar jawaban...";

      const capCanvas = document.createElement("canvas");
      const maxW = 1440;
      const scale = videoEl.videoWidth > maxW ? maxW / videoEl.videoWidth : 1;
      capCanvas.width = videoEl.videoWidth * scale;
      capCanvas.height = videoEl.videoHeight * scale;
      capCanvas.getContext("2d").drawImage(videoEl, 0, 0, capCanvas.width, capCanvas.height);
      const base64Data = capCanvas.toDataURL("image/jpeg", 0.85).split(",")[1];

      const modeOcr = localStorage.getItem("asas_ocr_mode") || "SIMULASI";
      const apiKey = localStorage.getItem("asas_ocr_key") || "";

      const fb = document.getElementById("scan-feedback");
      fb.className = "p-3.5 rounded-xl text-xs font-semibold bg-teal-50 text-teal-800 border border-teal-200";
      fb.textContent = "Mengekstrak jawaban & menghitung skor...";
      fb.classList.remove("hidden");

      try {
        let hasilOcr = null;
        if (modeOcr === "SIMULASI") {
          const opsi = paket.jenjang === "SMA" ? ["A", "B", "C", "D", "E"] : ["A", "B", "C", "D"];
          const namaDummy = ["Ahmad Fauzi", "Nabila Putri", "Rizky Pratama", "Aisyah Rahma", "Dimas Saputra"];
          const jawSim = {};
          paket.daftarSoal.forEach(s => {
            jawSim["no_" + s.no] = Math.random() < 0.75 ? s.kunci.join(", ") : opsi[Math.floor(Math.random() * opsi.length)];
          });
          hasilOcr = {
            identitas: { nama_siswa: namaDummy[Math.floor(Math.random() * namaDummy.length)] + " (Simulasi)", kelas: paket.jenjang === "SMA" ? "X-A" : "VII-A" },
            jawaban_pg: jawSim
          };
        } else {
          const ocrRes = await fetch("/api/ocr-proxy", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Authorization": "Bearer " + authToken },
            body: JSON.stringify({ modeOcr, apiKey, base64Image: base64Data, jenjang: paket.jenjang, jumlahSoal: paket.daftarSoal.length })
          });
          hasilOcr = await ocrRes.json();
          if (!ocrRes.ok) throw new Error(hasilOcr.error || "Gagal membaca foto.");
        }

        const penilaian = hitungKoreksiDiBrowser(hasilOcr, paket);

        await fetch("/api/hasil", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Authorization": "Bearer " + authToken },
          body: JSON.stringify({ paketId: paket.idPaket, ...penilaian })
        });

        document.getElementById("focus-progress").style.width = "0%";
        steadyTickCount = 0;
        fb.className = "p-3.5 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200";
        fb.textContent = `Terekam: ${penilaian.namaSiswa} (${penilaian.kelas}) | Nilai: ${penilaian.nilaiAkhir}`;
        muatAntreanHasil();

        scannerState = "WAITING_SWAP";
        badge.textContent = "Selesai! Geser ke lembar berikutnya...";
      } catch (err) {
        document.getElementById("focus-progress").style.width = "0%";
        steadyTickCount = 0;
        fb.className = "p-3.5 rounded-xl text-xs font-semibold bg-rose-50 text-rose-800 border border-rose-200";
        fb.textContent = err.message;
        scannerState = "SCANNING";
      }
    }

    function hitungKoreksiDiBrowser(hasilOcr, paket) {
      const jawabanObj = hasilOcr.jawaban_pg || {};
      let totalNilai = 0, daftarSalahCetak = [], skorPerSoal = [], pointerNomor = [];

      paket.daftarSoal.forEach(item => {
        const rawJawab = jawabanObj["no_" + item.no];
        if (!rawJawab || typeof rawJawab === "object") {
          pointerNomor.push(item.no);
          skorPerSoal.push(0);
          daftarSalahCetak.push(`${item.no}(Kosong->${item.kunci.join(",")})`);
          return;
        }
        const jawabArr = [...new Set(String(rawJawab).toUpperCase().split(",").map(s => s.trim()).filter(Boolean))].sort();
        const kunciArr = [...item.kunci].map(s => s.toUpperCase().trim()).sort();

        if (item.tipe === "PG") {
          if (jawabArr.length === 1 && jawabArr[0] === kunciArr[0]) {
            totalNilai += item.bobot;
            skorPerSoal.push(item.bobot);
          } else {
            skorPerSoal.push(0);
            daftarSalahCetak.push(`${item.no}(${jawabArr.join(",")}->${kunciArr.join(",")})`);
          }
        } else {
          const adaSalah = jawabArr.some(o => !kunciArr.includes(o));
          if (adaSalah || jawabArr.length === 0) {
            skorPerSoal.push(0);
            daftarSalahCetak.push(`${item.no}(${jawabArr.join(",")}->${kunciArr.join(",")})`);
          } else if (paket.aturanMcma === "MUTLAK") {
            if (jawabArr.length === kunciArr.length) {
              totalNilai += item.bobot;
              skorPerSoal.push(item.bobot);
            } else {
              skorPerSoal.push(0);
              daftarSalahCetak.push(`${item.no}(${jawabArr.join(",")}->${kunciArr.join(",")})`);
            }
          } else {
            const skorParsial = Math.round(((jawabArr.length / kunciArr.length) * item.bobot) * 100) / 100;
            totalNilai += skorParsial;
            skorPerSoal.push(skorParsial);
            if (jawabArr.length < kunciArr.length) daftarSalahCetak.push(`${item.no}(${jawabArr.join(",")}->${kunciArr.join(",")})`);
          }
        }
      });

      return {
        namaSiswa: hasilOcr.identitas?.nama_siswa || "Tanpa Nama",
        kelas: hasilOcr.identitas?.kelas || "-",
        nilaiAkhir: Math.round(totalNilai * 10) / 10,
        statusValidasi: pointerNomor.length > 0 ? "Cek No: " + pointerNomor.join(",") : "Valid",
        ringkasanCetak: daftarSalahCetak.length > 0 ? "Koreksi: " + daftarSalahCetak.join(", ") : "Sempurna (Semua Benar)",
        rawJawaban: jawabanObj,
        skorPerSoal: skorPerSoal
      };
    }

    async function muatAntreanHasil() {
      const idPaket = document.getElementById("scan-pilih-paket").value;
      if (!idPaket) return;
      const paket = getPaketAktifObj(idPaket);
      if (paket) document.getElementById("ekspor-pilih-mapel").value = paket.mapel;

      const res = await fetch(`/api/hasil/paket/${idPaket}`, { headers: { "Authorization": "Bearer " + authToken } });
      const rows = await res.json();
      antreanHasilGlobal = rows.map(r => ({
        nama: r.nama_siswa,
        kelas: r.kelas,
        nilaiAkhir: Number(r.nilai_akhir) || 0,
        statusValidasi: r.status_validasi,
        ringkasanCetak: r.ringkasan_cetak,
        rawJawaban: JSON.parse(r.raw_jawaban_json || "{}"),
        skorPerSoal: JSON.parse(r.skor_per_soal_json || "[]"),
        offsetTop: paket ? paket.offsetTop : 52
      }));
      document.getElementById("jumlah-antrean").textContent = antreanHasilGlobal.length;

      const tbody = document.getElementById("tbody-antrean");
      if (antreanHasilGlobal.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-400">Belum ada lembar jawaban dipindai.</td></tr>`;
        return;
      }

      tbody.innerHTML = antreanHasilGlobal.map((item, idx) => `
        <tr class="hover:bg-slate-50">
          <td class="py-2.5 px-3 font-bold">${idx + 1}</td>
          <td class="py-2.5 px-3">
            <div class="font-bold text-slate-900">${item.nama}</div>
            <div class="text-[11px] text-slate-500">${item.kelas} | ${item.statusValidasi}</div>
          </td>
          <td class="py-2.5 px-3 font-extrabold text-teal-700 text-sm">${item.nilaiAkhir}</td>
          <td class="py-2.5 px-3 text-[11px] text-slate-600 max-w-xs truncate">${item.ringkasanCetak}</td>
          <td class="py-2.5 px-3 text-right">
            <button onclick="bukaModalCetak([${idx}])" class="px-2.5 py-1 rounded-lg bg-slate-100 font-bold text-slate-700">Pratinjau & Print</button>
          </td>
        </tr>
      `).join("");
    }


    /* =====================================================================
       ENGINE TEMA CETAK TIMPA, LINGKARAN KUNCI & PRATINJAU INTERAKTIF A4
