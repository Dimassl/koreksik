    function ubahJumlahSoalConfig() {
      let targetJumlah = parseInt(document.getElementById("cfg-jumlah-soal").value, 10);
      if (isNaN(targetJumlah) || targetJumlah < 1) targetJumlah = 1;
      if (targetJumlah > 100) {
        targetJumlah = 100;
        document.getElementById("cfg-jumlah-soal").value = 100;
      }

      const panjangLama = dataSoalConfig.length;
      if (targetJumlah > panjangLama) {
        for (let i = panjangLama; i < targetJumlah; i++) {
          dataSoalConfig.push({
            no: i + 1,
            tipe: "PG",
            bobot: 2,
            kunci: []
          });
        }
      } else if (targetJumlah < panjangLama) {
        dataSoalConfig = dataSoalConfig.slice(0, targetJumlah);
      }

      renderMatriksConfig();
    }

    function terapkanPresetMcmaAkhir() {
      const total = dataSoalConfig.length;
      const jmlMcma = Math.max(1, Math.round(total * 0.25));
      const mulai = total - jmlMcma + 1;
      dataSoalConfig.forEach(s => {
        s.tipe = s.no >= mulai ? "MCMA" : "PG";
        s.bobot = s.tipe === "MCMA" ? 4 : 2;
        if (s.tipe === "PG" && s.kunci.length > 1) s.kunci = [s.kunci[0]];
      });
      renderMatriksConfig();
    }


    async function unduhExcelPerMapel() {
      const mapel = document.getElementById("ekspor-pilih-mapel").value;
      const kktp = Number(document.getElementById("ekspor-kktp").value) || 75;
      if (!mapel) return alert("Pilih mata pelajaran.");

      const res = await fetch(`/api/hasil/mapel/${encodeURIComponent(mapel)}`, { headers: { "Authorization": "Bearer " + authToken } });
      const dataMapel = await res.json();
      if (dataMapel.length === 0) return alert("Belum ada data nilai untuk mapel " + mapel);

      const wb = XLSX.utils.book_new();
      const rowsNilai = dataMapel.map((d, idx) => ({
        "No": idx + 1,
        "Nama Siswa": d.nama_siswa,
        "Kelas": d.kelas,
        "Paket Soal": d.nama_paket,
        "Nilai Akhir": d.nilai_akhir,
        "Status KKTP": d.nilai_akhir >= kktp ? "TUNTAS" : "REMEDIAL",
        "Rincian Koreksi": d.ringkasan_cetak
      }));
      XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rowsNilai), "Rekap Nilai");

      const paketMapel = daftarPaketDecrypted.filter(p => p.mapel.toLowerCase() === mapel.toLowerCase());
      let rowsAnbuso = [];
      for (const pkt of paketMapel) {
        const siswaPkt = dataMapel.filter(d => d.paket_id === pkt.idPaket);
        if (siswaPkt.length >= 2) {
          const hasilAnb = hitungStatistikAnbuso(pkt, siswaPkt, kktp);
          hasilAnb.hasilButir.forEach(b => {
            rowsAnbuso.push({
              "Paket": pkt.namaPaket,
              "No": b.no,
              "Tipe": b.tipe,
              "Kunci": b.kunci.join(", "),
              "Kesukaran (P)": b.pIndex,
              "Kategori P": b.kategoriKesukaran,
              "Daya Pembeda (D)": b.dIndex,
              "Kategori D": b.kategoriDayaPembeda,
              "Keputusan": b.keputusan,
              "Catatan": b.catatan
            });
          });
        }
      }
      if (rowsAnbuso.length > 0) {
        XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rowsAnbuso), "Analisis Butir Soal");
      }

      XLSX.writeFile(wb, `Rekap_ASAS_${mapel.replace(/\s+/g, "_")}.xlsx`);
