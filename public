    function ambilOpsiCetakSaatIni() {
      const preset = document.getElementById("prev-ljk-preset").value;
      const cols = preset === "4col" ? 4 : (preset === "1col" ? 1 : 2);
      return {
        tema: temaCetakAktif,
        offsetTop: Number(document.getElementById("prev-offset-top").value) || 52,
        warnaTinta: document.getElementById("prev-warna-tinta").value || "#dc2626",
        lingkarGrid: document.getElementById("prev-aktif-lingkar-grid").checked,
        ringkasanAtas: document.getElementById("prev-aktif-ringkasan-atas").checked,
        ljkCols: cols,
        ljkTop: Number(document.getElementById("prev-ljk-top").value) || 98,
        ljkLeft: Number(document.getElementById("prev-ljk-left").value) || 34,
        ljkRowH: Number(document.getElementById("prev-ljk-rowh").value) || 7.5,
        ljkColW: Number(document.getElementById("prev-ljk-colw").value) || 85,
        ljkOptGap: Number(document.getElementById("prev-ljk-optgap").value) || 8.5
      };
    }

    function evaluasiItemSiswaUntukCetak(itemSiswa, paket) {
      const soalList = paket ? paket.daftarSoal : dataSoalConfig;
      const rawJawab = itemSiswa.rawJawaban || {};
      const skorList = itemSiswa.skorPerSoal || [];
      let jumlahBenar = 0;
      let detailSalah = [];

      soalList.forEach((soal, idx) => {
        const skor = skorList[idx] !== undefined ? Number(skorList[idx]) : soal.bobot;
        const jawStr = rawJawab["no_" + soal.no] || "";
        if (skor >= soal.bobot) {
          jumlahBenar++;
        } else {
          detailSalah.push({
            no: soal.no,
            tipe: soal.tipe,
            kunci: soal.kunci,
            jawabanSiswa: jawStr ? String(jawStr) : "Kosong"
          });
        }
      });

      return {
        totalSoal: soalList.length,
        jumlahBenar: jumlahBenar,
        jumlahSalah: soalList.length - jumlahBenar,
        detailSalah: detailSalah,
        jenjang: paket ? paket.jenjang : "SMA"
      };
    }

    function buatHtmlSatuKertas(itemSiswa, paket, cfg, scaleFactor = 1) {
      const u = (mm) => scaleFactor === 1 ? `${mm}mm` : `${Math.round(mm * scaleFactor * 10) / 10}px`;
      const fSize = (pt) => scaleFactor === 1 ? `${pt}pt` : `${Math.round(pt * 0.72 * 10) / 10}px`;

      const evalData = evaluasiItemSiswaUntukCetak(itemSiswa, paket);
      const nilai = itemSiswa.nilaiAkhir;
      const statusLulus = nilai >= 75 ? "TUNTAS" : "REMEDIAL";
      const warna = cfg.warnaTinta;

      // 1. Render Kotak Angka Nilai Sesuai Tema
      let stampHtml = "";
      if (cfg.tema === "circle") {
        const diam = scaleFactor === 1 ? "21mm" : "44px";
        stampHtml = `
          <div style="position: absolute; right: ${u(14)}; top: ${u(cfg.offsetTop)}; width: ${diam}; height: ${diam}; border-radius: 9999px; border: 2px double ${warna}; color: ${warna}; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
            <span style="font-size: ${fSize(6.5)}; font-weight: 800; letter-spacing: 0.5px;">NILAI</span>
            <span style="font-size: ${fSize(15)}; font-weight: 900; line-height: 1.05;">${nilai}</span>
          </div>`;
      } else if (cfg.tema === "minimal") {
        stampHtml = `
          <div style="position: absolute; right: ${u(14)}; top: ${u(cfg.offsetTop)}; border-bottom: 2.5px double ${warna}; color: ${warna}; padding: 1px 6px 2px 6px; text-align: center;">
            <div style="font-size: ${fSize(6.5)}; font-weight: 700; text-transform: uppercase;">Skor Akhir</div>
            <div style="font-size: ${fSize(17)}; font-weight: 900; line-height: 1.05;">${nilai}</div>
          </div>`;
      } else if (cfg.tema === "card") {
        stampHtml = `
          <div style="position: absolute; right: ${u(14)}; top: ${u(cfg.offsetTop)}; border: 1.5px solid ${warna}; border-left: 4px solid ${warna}; background: #fff; padding: ${scaleFactor === 1 ? '2mm 3mm' : '3px 6px'}; border-radius: 4px; color: #0f172a;">
            <div style="display: flex; align-items: baseline; gap: 6px;">
              <span style="font-size: ${fSize(15)}; font-weight: 900; color: ${warna}; line-height: 1;">${nilai}</span>
              <span style="font-size: ${fSize(6.5)}; font-weight: 800; padding: 1px 4px; border: 1px solid ${warna}; border-radius: 3px; color: ${warna};">${statusLulus}</span>
            </div>
            <div style="font-size: ${fSize(6.5)}; font-weight: 700; margin-top: 2px; color: #334155;">
              Benar: ${evalData.jumlahBenar} | Salah: ${evalData.jumlahSalah}
            </div>
          </div>`;
      } else {
        stampHtml = `
          <div style="position: absolute; right: ${u(14)}; top: ${u(cfg.offsetTop)}; border: 1.8px solid ${warna}; background: #fff; padding: ${scaleFactor === 1 ? '1.5mm 3.5mm' : '3px 7px'}; text-align: center; color: ${warna};">
            <div style="font-size: ${fSize(6.5)}; font-weight: 800; border-bottom: 1px solid ${warna}; padding-bottom: 1px; margin-bottom: 1px;">NILAI ASAS</div>
            <div style="font-size: ${fSize(16)}; font-weight: 900; line-height: 1.1;">${nilai}</div>
          </div>`;
      }

      // 2. Render Ringkasan Nomor Salah di Atas (Dengan Lingkaran pada Kunci Jawaban Benar)
      let ringkasanHtml = "";
      if (cfg.ringkasanAtas) {
        let isiKoreksi = "";
        if (evalData.detailSalah.length === 0) {
          isiKoreksi = `<span style="color: #059669; font-weight: 800;">Sempurna (Semua Jawaban Benar)</span>`;
        } else {
          const itemBadges = evalData.detailSalah.map(s => {
            const kunciCircled = s.kunci.map(k =>
              `<span style="display:inline-flex; align-items:center; justify-content:center; width:${scaleFactor === 1 ? '3.6mm' : '11px'}; height:${scaleFactor === 1 ? '3.6mm' : '11px'}; border-radius:9999px; border:1.2px solid ${warna}; color:${warna}; font-weight:900; font-size:${fSize(6.5)}; margin:0 1px;">${k}</span>`
            ).join("");
            return `<span style="display:inline-block; margin-right: 5px; margin-bottom: 2px;">No.${s.no}: <span style="text-decoration:line-through; opacity:0.75;">${s.jawabanSiswa}</span> &rarr; Kunci ${kunciCircled}</span>`;
          }).join("");
          isiKoreksi = `<div style="margin-top: 2px;">${itemBadges}</div>`;
        }

        ringkasanHtml = `
          <div style="position: absolute; left: ${u(20)}; right: ${u(52)}; top: ${u(cfg.offsetTop)}; font-size: ${fSize(7.2)}; line-height: 1.3; color: #0f172a; background: rgba(255,255,255,0.92); padding: 2px 4px; border-left: 2px solid ${warna};">
            <div style="font-weight: 800;">${itemSiswa.nama} (${itemSiswa.kelas}) &bull; Benar ${evalData.jumlahBenar}/${evalData.totalSoal}</div>
            ${isiKoreksi}
          </div>`;
      }

      // 3. Render Lingkaran Langsung di Atas Grid Pilihan Jawaban LJK untuk Nomor yang Salah
      let lingkaranGridHtml = "";
      if (cfg.lingkarGrid && evalData.detailSalah.length > 0) {
        const hurufList = ["A", "B", "C", "D", "E"];
        const rowsPerCol = Math.ceil(evalData.totalSoal / cfg.ljkCols);
        const circleDiam = scaleFactor === 1 ? "4.8mm" : "10px";

        evalData.detailSalah.forEach(salah => {
          const idxSoal = salah.no - 1;
          const colIdx = Math.floor(idxSoal / rowsPerCol);
          const rowIdx = idxSoal % rowsPerCol;
          const yMm = cfg.ljkTop + (rowIdx * cfg.ljkRowH);

          salah.kunci.forEach(hurufBenar => {
            const optIdx = hurufList.indexOf(hurufBenar.toUpperCase());
            if (optIdx >= 0) {
              const xMm = cfg.ljkLeft + (colIdx * cfg.ljkColW) + (optIdx * cfg.ljkOptGap);
              lingkaranGridHtml += `
                <div style="position: absolute; left: ${u(xMm)}; top: ${u(yMm)}; width: ${circleDiam}; height: ${circleDiam}; border: 1.6px solid ${warna}; border-radius: 9999px; transform: translate(-50%, -50%); box-sizing: border-box;"></div>`;
            }
          });
        });
      }

      return stampHtml + ringkasanHtml + lingkaranGridHtml;
    }

    function renderPratinjauCetak() {
      const cfg = ambilOpsiCetakSaatIni();
      const idPaket = document.getElementById("scan-pilih-paket").value;
      const paket = getPaketAktifObj(idPaket);
      const totalSoal = paket ? paket.daftarSoal.length : dataSoalConfig.length;
      const opsiHuruf = (paket ? paket.jenjang : "SMA") === "SMA" ? ["A", "B", "C", "D", "E"] : ["A", "B", "C", "D"];

      let sampelSiswa = null;
      if (targetCetakIndices && targetCetakIndices.length > 0 && antreanHasilGlobal[targetCetakIndices[0]]) {
        sampelSiswa = antreanHasilGlobal[targetCetakIndices[0]];
      } else if (antreanHasilGlobal.length > 0) {
        sampelSiswa = antreanHasilGlobal[0];
      } else {
        const soalRef = paket ? paket.daftarSoal : dataSoalConfig;
        const dummyRaw = {};
        const dummySkor = [];
        soalRef.forEach((s, idx) => {
          const kunciUtama = s.kunci.length > 0 ? s.kunci[0] : "A";
          if (idx === 1 || idx === 4 || idx === 8) {
            dummyRaw["no_" + s.no] = kunciUtama === "A" ? "B" : "A";
            dummySkor.push(0);
          } else {
            dummyRaw["no_" + s.no] = s.kunci.length > 0 ? s.kunci.join(", ") : "A";
            dummySkor.push(s.bobot);
          }
        });
        sampelSiswa = {
          nama: "Nabila Putri (Contoh)",
          kelas: "X-A",
          nilaiAkhir: 92.5,
          rawJawaban: dummyRaw,
          skorPerSoal: dummySkor
        };
      }

      document.getElementById("preview-sample-info").textContent = `Pratinjau: ${sampelSiswa.nama} (${sampelSiswa.kelas})`;

      const scale = 2.1; // 210mm * 2.1 = 441px
      const rowsPerCol = Math.ceil(totalSoal / cfg.ljkCols);
      let ghostGrid = `
        <div style="border-bottom: 1px solid #94a3b8; margin: 16px 24px 8px 24px; padding-bottom: 6px; font-size: 8px; color: #475569; font-weight: 700;">
          LEMBAR JAWABAN ASESMEN SUMATIF AKHIR SEMESTER (SKETSA KERTAS SISWA)
        </div>`;

      for (let i = 0; i < totalSoal; i++) {
        const colIdx = Math.floor(i / rowsPerCol);
        const rowIdx = i % rowsPerCol;
        const yPx = (cfg.ljkTop + rowIdx * cfg.ljkRowH) * scale;
        const xNoPx = (cfg.ljkLeft + colIdx * cfg.ljkColW - 7) * scale;
        ghostGrid += `<span style="position:absolute; left:${xNoPx}px; top:${yPx}px; transform:translate(-50%,-50%); font-size:6.5px; color:#64748b; font-weight:700;">${i + 1}.</span>`;

        opsiHuruf.forEach((h, oIdx) => {
          const xOptPx = (cfg.ljkLeft + colIdx * cfg.ljkColW + oIdx * cfg.ljkOptGap) * scale;
          ghostGrid += `<span style="position:absolute; left:${xOptPx}px; top:${yPx}px; transform:translate(-50%,-50%); font-size:6.5px; color:#64748b;">${h}</span>`;
        });
      }

      document.getElementById("a4-ghost-sheet").innerHTML = ghostGrid;
      document.getElementById("a4-overlay-layer").innerHTML = buatHtmlSatuKertas(sampelSiswa, paket, cfg, scale);
    }

