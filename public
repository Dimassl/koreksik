<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart ASAS - Platform Evaluasi & Anbuso</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; color: #0f172a; }
    .navy-header { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }

    #print-area { display: none; }
    @media print {
      @page { size: A4 portrait; margin: 0; }
      body { background: #fff; margin: 0; padding: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .no-print { display: none !important; }
      #print-area { display: block !important; }
      .kertas-siswa {
        position: relative;
        width: 210mm;
        height: 297mm;
        page-break-after: always;
        overflow: hidden;
      }
    }

  </style>
</head>
<body class="min-h-screen pb-16">

  <!-- LAYAR LOGIN / REGISTRASI & PIN ENKRIPSI GURU -->
  <div id="auth-screen" class="min-h-screen flex items-center justify-center p-4 bg-slate-900 no-print">
    <div class="bg-white rounded-3xl max-w-md w-full p-7 shadow-2xl space-y-5">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-teal-600 text-white flex items-center justify-center">
          <span class="material-icons-round text-2xl">center_focus_strong</span>
        </div>
        <div>
          <h1 class="text-lg font-extrabold text-slate-900">Smart ASAS Studio</h1>
          <p class="text-xs text-slate-500">Koreksi LJK Kamera, Cetak Timpa & Anbuso</p>
        </div>
      </div>

      <div class="flex bg-slate-100 p-1 rounded-xl text-xs font-bold">
        <button onclick="switchAuthTab('login')" id="tab-auth-login" class="flex-1 py-2 rounded-lg bg-white text-slate-900 shadow-sm">Masuk Akun</button>
        <button onclick="switchAuthTab('register')" id="tab-auth-reg" class="flex-1 py-2 rounded-lg text-slate-500">Daftar Guru Baru</button>
      </div>

      <div id="auth-nama-box" class="hidden">
        <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap & Gelar</label>
        <input type="text" id="auth-nama" placeholder="Contoh: Dimas Sekar Langit, S.Pd" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Email</label>
        <input type="email" id="auth-email" placeholder="nama@sekolah.sch.id" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Password Akun</label>
        <input type="password" id="auth-password" placeholder="Minimal 6 karakter" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
      </div>

      <div class="p-3.5 rounded-2xl bg-teal-50 border border-teal-200 space-y-2">
        <label class="block text-xs font-extrabold text-teal-900 flex items-center gap-1.5">
          <span class="material-icons-round text-base text-teal-700">vpn_key</span>
          PIN Enkripsi Kunci Jawaban (Zero-Knowledge)
        </label>
        <input type="password" id="auth-pin" placeholder="Masukkan PIN rahasia Anda" class="w-full px-3.5 py-2 rounded-xl border border-teal-300 bg-white text-sm font-bold">
        <p class="text-[11px] text-teal-800 leading-snug">PIN ini mengenkripsi kunci jawaban di browser Anda. Server tidak menyimpan PIN ini.</p>
      </div>

      <button onclick="submitAuth()" id="btn-auth-submit" class="w-full py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow-md transition">
        Masuk ke Ruang Kerja
      </button>
    </div>
  </div>

  <!-- APLIKASI UTAMA -->
  <div id="main-app" class="hidden">
    <header class="navy-header text-white sticky top-0 z-40 shadow-md no-print">
      <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-500/20 border border-teal-400/30 flex items-center justify-center text-teal-300">
            <span class="material-icons-round">center_focus_strong</span>
          </div>
          <div>
            <h1 class="text-base font-extrabold tracking-tight">Smart ASAS Studio</h1>
            <div class="flex items-center gap-2 text-[11px] text-slate-300">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
              <span id="user-display-label">-</span>
            </div>
          </div>
        </div>

        <nav class="flex items-center gap-1.5 bg-slate-900/90 p-1.5 rounded-xl border border-slate-700">
          <button onclick="bukaModul('scan')" id="nav-scan" class="px-3.5 py-2 rounded-lg text-xs font-bold bg-teal-600 text-white flex items-center gap-1.5 transition">
            <span class="material-icons-round text-base">videocam</span>
            1. Live Scan & Ekspor
          </button>
          <button onclick="bukaModul('config')" id="nav-config" class="px-3.5 py-2 rounded-lg text-xs font-bold text-slate-300 hover:text-white flex items-center gap-1.5 transition">
            <span class="material-icons-round text-base">tune</span>
            2. Konfigurasi Paket
          </button>
          <button onclick="bukaModul('anbuso')" id="nav-anbuso" class="px-3.5 py-2 rounded-lg text-xs font-bold text-slate-300 hover:text-white flex items-center gap-1.5 transition">
            <span class="material-icons-round text-base">analytics</span>
            3. Analisis Butir Soal
          </button>
        </nav>

        <div class="flex items-center gap-2">
          <button onclick="bukaModalOcr()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs font-bold text-slate-200 flex items-center gap-1.5">
            <span class="material-icons-round text-sm text-teal-400">key</span>
            <span>API OCR</span>
          </button>
          <button onclick="logout()" class="p-2 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 border border-rose-400/30 text-rose-300" title="Keluar">
            <span class="material-icons-round text-base">logout</span>
          </button>
        </div>
      </div>
    </header>

    <!-- MODAL PENGATURAN API OCR LOKAL -->
    <div id="modal-ocr" class="hidden fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-4 no-print">
      <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-sm font-extrabold text-slate-900">Pengaturan Mesin Pembaca (OCR)</h3>
          <button onclick="tutupModalOcr()" class="text-slate-400 hover:text-slate-700"><span class="material-icons-round">close</span></button>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Mode Pembacaan</label>
          <select id="ocr-mode-select" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold bg-white">
            <option value="SIMULASI">Mode Simulasi (Tes Tanpa API Key)</option>
            <option value="GEMINI">Gemini 3.5 Flash-Lite (Google AI Studio)</option>
            <option value="SNAPTOJSON">Snaptojson API</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">API Key Pribadi (Disimpan di Browser Anda)</label>
          <input type="password" id="ocr-api-key-input" placeholder="Tempel API Key Gemini atau Snaptojson" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs">
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button onclick="tutupModalOcr()" class="px-4 py-2 rounded-xl border border-slate-300 text-xs font-bold">Batal</button>
          <button onclick="simpanSettingOcr()" class="px-4 py-2 rounded-xl bg-teal-600 text-white text-xs font-bold">Simpan</button>
        </div>
      </div>
    </div>


  <!-- MODAL PENGATURAN TEMA CETAK TIMPA, LINGKARAN KUNCI & PRATINJAU A4 -->
  <div id="modal-cetak-preview" class="hidden fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5 no-print overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-5xl w-full shadow-2xl border border-slate-200 overflow-hidden my-auto">
      <div class="navy-header text-white px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="material-icons-round text-teal-300">print</span>
          <div>
            <h3 class="text-sm font-extrabold">Tema Cetak Timpa, Lingkaran Koreksi & Pratinjau A4</h3>
            <p class="text-[11px] text-slate-300">Sesuaikan gaya angka nilai dan posisi lingkaran jawaban benar sebelum mencetak ke kertas siswa</p>
          </div>
        </div>
        <button onclick="tutupModalCetak()" class="text-slate-300 hover:text-white"><span class="material-icons-round">close</span></button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12">
        <!-- Panel Kontrol Kiri -->
        <div class="lg:col-span-5 p-5 border-b lg:border-b-0 lg:border-r border-slate-200 space-y-4 max-h-[78vh] overflow-y-auto">
          <div>
            <label class="block text-xs font-extrabold text-slate-800 mb-2">1. Pilih Tema Cetakan Angka Nilai</label>
            <div class="grid grid-cols-2 gap-2" id="pilihan-tema-grid">
              <button type="button" onclick="pilihTemaCetak('classic')" id="tema-btn-classic" class="p-2.5 rounded-xl border-2 border-teal-600 bg-teal-50/60 text-left transition">
                <div class="text-xs font-extrabold text-slate-900">Klasik Kotak</div>
                <div class="text-[10px] text-slate-500 mt-0.5">Bingkai tegas double-border</div>
              </button>
              <button type="button" onclick="pilihTemaCetak('circle')" id="tema-btn-circle" class="p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-left transition">
                <div class="text-xs font-extrabold text-slate-900">Stempel Bulat</div>
                <div class="text-[10px] text-slate-500 mt-0.5">Lingkaran stempel guru</div>
              </button>
              <button type="button" onclick="pilihTemaCetak('minimal')" id="tema-btn-minimal" class="p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-left transition">
                <div class="text-xs font-extrabold text-slate-900">Minimalis Garis</div>
                <div class="text-[10px] text-slate-500 mt-0.5">Angka besar + garis bawah</div>
              </button>
              <button type="button" onclick="pilihTemaCetak('card')" id="tema-btn-card" class="p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-left transition">
                <div class="text-xs font-extrabold text-slate-900">Kartu Rincian</div>
                <div class="text-[10px] text-slate-500 mt-0.5">Nilai + Benar/Salah + Status</div>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Posisi Atas Nilai (mm)</label>
              <input type="number" id="prev-offset-top" value="52" oninput="renderPratinjauCetak()" class="w-full px-3 py-1.5 rounded-xl border border-slate-300 text-xs font-bold">
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Warna Tinta Koreksi</label>
              <select id="prev-warna-tinta" onchange="renderPratinjauCetak()" class="w-full px-2.5 py-1.5 rounded-xl border border-slate-300 text-xs font-bold bg-white">
                <option value="#dc2626">Merah Koreksi (Disarankan)</option>
                <option value="#0f172a">Hitam Pekat (Laser Monokrom)</option>
                <option value="#0d9488">Tosca Gelap</option>
              </select>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
            <div class="flex items-center justify-between">
              <label class="text-xs font-extrabold text-slate-800 flex items-center gap-1.5">
                <span class="material-icons-round text-sm text-rose-600">radio_button_unchecked</span>
                2. Lingkari Kunci pada Soal Salah
              </label>
              <input type="checkbox" id="prev-aktif-lingkar-grid" checked onchange="renderPratinjauCetak()" class="w-4 h-4 accent-teal-600">
            </div>
            <p class="text-[11px] text-slate-600 leading-snug">Otomatis melingkari huruf kunci jawaban yang benar tepat di atas opsi A/B/C/D/E pada nomor yang dijawab salah oleh siswa.</p>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[10px] font-bold text-slate-600 mb-0.5">Tata Letak Kolom LJK</label>
                <select id="prev-ljk-preset" onchange="terapkanPresetLjk()" class="w-full px-2 py-1.5 rounded-lg border border-slate-300 text-[11px] font-bold bg-white">
                  <option value="2col">2 Kolom (20 soal/kolom)</option>
                  <option value="4col">4 Kolom (10 soal/kolom)</option>
                  <option value="1col">1 Kolom Memanjang</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-600 mb-0.5">Atas Grid LJK (mm)</label>
                <input type="number" id="prev-ljk-top" value="98" oninput="renderPratinjauCetak()" class="w-full px-2 py-1 rounded-lg border border-slate-300 text-xs font-bold">
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-600 mb-0.5">Kiri Kolom 1 (mm)</label>
                <input type="number" id="prev-ljk-left" value="34" oninput="renderPratinjauCetak()" class="w-full px-2 py-1 rounded-lg border border-slate-300 text-xs font-bold">
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-600 mb-0.5">Jarak Antar Baris (mm)</label>
                <input type="number" step="0.5" id="prev-ljk-rowh" value="7.5" oninput="renderPratinjauCetak()" class="w-full px-2 py-1 rounded-lg border border-slate-300 text-xs font-bold">
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-600 mb-0.5">Lebar Antar Kolom (mm)</label>
                <input type="number" id="prev-ljk-colw" value="85" oninput="renderPratinjauCetak()" class="w-full px-2 py-1 rounded-lg border border-slate-300 text-xs font-bold">
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-600 mb-0.5">Jarak Opsi A-E (mm)</label>
                <input type="number" step="0.5" id="prev-ljk-optgap" value="8.5" oninput="renderPratinjauCetak()" class="w-full px-2 py-1 rounded-lg border border-slate-300 text-xs font-bold">
              </div>
            </div>

            <label class="flex items-center gap-2 text-[11px] font-semibold text-slate-700 pt-1">
              <input type="checkbox" id="prev-aktif-ringkasan-atas" checked onchange="renderPratinjauCetak()" class="w-3.5 h-3.5 accent-teal-600">
              Tampilkan juga daftar nomor salah dengan kunci dilingkari di bagian atas
            </label>
          </div>

          <div class="flex gap-2 pt-2">
            <button type="button" onclick="tutupModalCetak()" class="px-4 py-2.5 rounded-xl border border-slate-300 text-xs font-bold text-slate-700">Tutup</button>
            <button type="button" onclick="eksekusiPrintDariModal()" class="flex-1 py-2.5 px-4 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-extrabold flex items-center justify-center gap-1.5 shadow-md transition">
              <span class="material-icons-round text-base">print</span>
              <span id="btn-modal-print-label">Cetak Sekarang ke Kertas A4</span>
            </button>
          </div>
        </div>

        <!-- Panel Pratinjau Visual Kanan -->
        <div class="lg:col-span-7 bg-slate-200/80 p-5 flex flex-col items-center justify-center max-h-[78vh] overflow-y-auto">
          <div class="w-full flex items-center justify-between mb-2 px-1">
            <span class="text-[11px] font-extrabold text-slate-700 uppercase tracking-wider">Pratinjau Kertas A4 (210 x 297 mm)</span>
            <span id="preview-sample-info" class="text-[11px] font-semibold text-slate-600">Contoh: Siswa Simulasi</span>
          </div>
          <!-- Simulasi Kertas A4 Proporsional (Skala 1mm = 2.1px -> 441px x 623px) -->
          <div id="a4-preview-canvas" class="relative bg-white shadow-xl border border-slate-300 overflow-hidden" style="width: 441px; height: 623px;">
            <!-- Lapisan Bayangan Lembar Jawaban Asli (Hanya tampil di layar pratinjau, tidak ikut dicetak) -->
            <div id="a4-ghost-sheet" class="absolute inset-0 pointer-events-none opacity-45"></div>
            <!-- Lapisan Hasil Cetakan Timpa Sesungguhnya -->
            <div id="a4-overlay-layer" class="absolute inset-0 pointer-events-none"></div>
          </div>
        </div>
      </div>
    </div>
  </div>


    <main class="max-w-7xl mx-auto px-4 mt-6 no-print">

      <!-- MODUL 1: LIVE SCANNER, CETAK TIMPA & EKSPOR EXCEL PER MAPEL -->
      <div id="modul-scan" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <span class="material-icons-round text-teal-600">filter_center_focus</span>
                Kamera Auto-Focus
              </h2>
              <button type="button" id="btn-toggle-cam" onclick="toggleKamera()" class="px-3 py-1.5 rounded-lg bg-slate-900 text-white text-xs font-bold flex items-center gap-1">
                <span class="material-icons-round text-sm">videocam</span>
                Nyalakan
              </button>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Paket Soal Aktif</label>
              <select id="scan-pilih-paket" onchange="muatAntreanHasil()" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs font-bold bg-white">
                <option value="">Belum ada paket soal...</option>
              </select>
            </div>

            <div class="relative w-full aspect-[3/4] bg-slate-950 rounded-2xl overflow-hidden border border-slate-800 flex items-center justify-center">
              <video id="live-video" autoplay playsinline muted class="w-full h-full object-cover hidden"></video>
              <div id="cam-placeholder" class="text-center p-6 text-slate-400">
                <span class="material-icons-round text-5xl text-slate-600 mb-2">no_photography</span>
                <p class="text-xs font-semibold text-slate-300">Kamera Belum Aktif</p>
                <p class="text-[11px] mt-1">Klik <strong>Nyalakan</strong> lalu arahkan ke lembar jawaban hingga fokus terkunci otomatis.</p>
              </div>
              <div id="viewfinder-overlay" class="hidden absolute inset-0 pointer-events-none flex flex-col justify-between p-4">
                <div class="flex justify-center">
                  <span id="focus-badge" class="px-3 py-1 rounded-full text-[11px] font-bold bg-slate-900/80 text-white">Arahkan kertas ke bingkai...</span>
                </div>
                <div id="guide-box" class="w-full h-[78%] border-2 border-dashed border-white/50 rounded-xl relative"></div>
                <div class="w-full bg-slate-900/80 rounded-full h-2 overflow-hidden">
                  <div id="focus-progress" class="bg-emerald-400 h-full w-0 transition-all duration-100"></div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between gap-2 pt-1">
              <div class="flex items-center gap-2 text-[11px] text-slate-600">
                <span class="font-semibold">Ambang Fokus:</span>
                <select id="sensitivitas-fokus" class="px-2 py-1 rounded-lg border border-slate-300 bg-white font-semibold">
                  <option value="8">Cahaya Redup</option>
                  <option value="11" selected>Normal</option>
                  <option value="15">Ketat</option>
                </select>
              </div>
              <button type="button" onclick="jepretManualDariStream()" class="px-3 py-1.5 rounded-lg bg-teal-50 text-teal-800 border border-teal-200 text-xs font-bold">
                Baca Sekarang
              </button>
            </div>

            <div id="scan-feedback" class="hidden p-3.5 rounded-xl text-xs font-semibold"></div>
          </div>

          <div class="lg:col-span-7 space-y-5">
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3">
              <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <span class="material-icons-round text-emerald-600">table_view</span>
                Unduh Rekap Nilai & Anbuso ke Excel (.xlsx) Per Mapel
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-end">
                <div class="sm:col-span-6">
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">Mata Pelajaran</label>
                  <select id="ekspor-pilih-mapel" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-bold bg-white"></select>
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">KKTP</label>
                  <input type="number" id="ekspor-kktp" value="75" class="w-full px-2.5 py-2 rounded-xl border border-slate-300 text-xs font-bold text-center">
                </div>
                <div class="sm:col-span-4">
                  <button type="button" onclick="unduhExcelPerMapel()" class="w-full py-2 px-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold flex items-center justify-center gap-1.5 shadow-sm">
                    <span class="material-icons-round text-sm">download</span>
                    Unduh Excel (.xlsx)
                  </button>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
              <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div>
                  <h2 class="text-sm font-bold text-slate-900">Antrean Hasil Koreksi & Cetak Timpa</h2>
                  <p class="text-xs text-slate-500">Pilih tema cetakan nilai dan pratinjau lingkaran koreksi sebelum mencetak</p>
                </div>
                <div class="flex items-center gap-2">
